APP_NAME="Nema ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Bamako

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nema_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_STORE=

# En production HTTPS, activez les cookies de session sécurisés :
# SESSION_SECURE_COOKIE=true
# Pour chiffrer les données de session stockées, activez :
# SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
ODOO_RPC_TIMEOUT=45
ODOO_RPC_CONNECT_TIMEOUT=10
ODOO_IMPORT_BATCH_SIZE=250
ODOO_IMPORT_MAX_BATCH_SIZE=1000
ODOO_IMPORT_MAX_IMAGE_BYTES=8388608
ODOO_IMPORT_QUEUE=imports
ODOO_IMAGE_DISK=public
PRODUCT_MEDIA_DISK=public
DOCUMENT_ATTACHMENT_DISK=public
NEMA_EXPOSE_DEMO_CREDENTIALS=false
NEMA_ALLOW_DEMO_LOGIN=false
NEMA_DEMO_EMAIL_DOMAINS=nema-erp.test
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_HSTS_MAX_AGE=31536000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

WHATSAPP_WEBHOOK_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM=
WHATSAPP_TIMEOUT=10
INTEGRATIONS_WEBHOOK_TIMEOUT=10
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_TIMEOUT=10
OPS_ALERT_MINIMUM_LEVEL=warning
OPS_ALERT_RETRY_TIMES=3
OPS_ALERT_RETRY_BACKOFF_MS=300
OPS_ALERT_SIGNATURE_SECRET=
OPS_ALERT_CIRCUIT_FAILURES=5
OPS_ALERT_CIRCUIT_TTL_MINUTES=10
OPS_BACKUP_OFFSITE_DISK=
OPS_BACKUP_OFFSITE_PREFIX=nema-erp/backups
OPS_BACKUP_OFFSITE_KEEP=14
OPS_CORE_PULSE_SLA_SCORE=75
OPS_CORE_PULSE_WEIGHT_AUTOMATION=25
OPS_CORE_PULSE_WEIGHT_MONITORING=25
OPS_CORE_PULSE_WEIGHT_BACKUPS=20
OPS_CORE_PULSE_WEIGHT_ECOSYSTEM=15
OPS_CORE_PULSE_WEIGHT_READINESS=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production cloud reference:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://erp.example.com
# LOG_STACK=stderr,daily
# BROADCAST_CONNECTION=reverb
# VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
